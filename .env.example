# Copia este archivo a apps/web/.env.local y llénalo (docs/SETUP.md §4).
# En local, los valores de Supabase los imprime `supabase status`.

# Cliente y servidor
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo servidor — nunca con prefijo NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
CRON_SECRET=
